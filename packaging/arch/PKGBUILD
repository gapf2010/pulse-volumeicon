# Maintainer: German Pulido <1203374+gapf2010@users.noreply.github.com>

pkgname=pulse-volumeicon
pkgver=0.1.0
pkgrel=1
pkgdesc="Tray icon for PulseAudio and PipeWire volume control"
arch=('x86_64' 'aarch64')
url="https://github.com/gapf2010/pulse-volumeicon"
license=('MIT')
# libpulse provides pactl, which also works with PipeWire (pipewire-pulse)
depends=('glib2' 'gtk3' 'libayatana-appindicator' 'libnotify' 'libpulse')
makedepends=('pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Run `updpkgsums` once the v0.1.0 tag exists to fill this in
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	make PREFIX=/usr
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
